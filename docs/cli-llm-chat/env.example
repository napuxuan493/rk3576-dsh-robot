# 复制为 .env 后填写（勿提交含真实 Key 的 .env）
#   cp env.example .env && nano .env
# 或直接 export：
#
#   export LLM_API_BASE="https://api.deepseek.com"
#   export LLM_API_KEY="sk-..."
#   export LLM_MODEL="deepseek-chat"

# 已锁定：DeepSeek OpenAI 兼容
# BASE 不要末尾斜杠；脚本拼 /v1/chat/completions
# （若 BASE 已以 /v1 结尾，则拼 /chat/completions）
LLM_API_BASE=https://api.deepseek.com

# API Key（必填；本文件不要填真实值；本地写到 .env 并 chmod 600）
LLM_API_KEY=

# 模型名
LLM_MODEL=deepseek-chat

# 可选：系统提示
# LLM_SYSTEM="你是小智式桌面语音助手，回答简洁。"
