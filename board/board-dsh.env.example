# Board → DSH Desktop LAN bridge (copy to .env next to board-dsh-*.sh; chmod 600)
# Do NOT commit real cookies/tokens. Do NOT put Pinggy URLs here for board use.

# LAN root of Desktop mobile bridge (no /pair, no ?token=)
DSH_BASE_URL=http://10.23.9.124:43127

# After board-dsh-pair.sh (or phone pair on same LAN): cookie value only
# DSH_MOBILE_COOKIE=

# Short-lived pairing token from Desktop "Connect phone" — pair step only
# Prefer pasting the full URL instead of splitting manually:
#   ./board-dsh-pair-url.sh 'http://192.168.137.1:43127/pair?token=…'
# DSH_PAIR_TOKEN=

# Pin Desktop agent/session (preferred over session.list[0] / session.create)
# Switch: change this value or `DSH_SESSION_ID=… ./board-dsh-chat.sh`
DSH_SESSION_ID=session-dafeiyu-smoke-1793077192324

# --- Optional: DeepSeek (or other) TEXT/LLM key ---
# Used only if you call OpenAI-compatible /v1/chat/completions from the board.
# DeepSeek is TEXT-ONLY: api.deepseek.com has NO /v1/audio/transcriptions or /speech.
# OPENAI_API_KEY=   # e.g. DeepSeek key — does NOT enable ASR/TTS

# --- Preferred board voice: LAN bridge on PC (NOT DeepSeek speech) ---
# See docs/dsh-voice-bridge.md. Uses same DSH_MOBILE_COOKIE + DSH_SESSION_ID.
# PC must run: node %USERPROFILE%\dsh-voice-bridge\server.mjs (Desktop up)
DSH_VOICE_BRIDGE_URL=http://192.168.137.1:43128
# DSH_VOICE_TURN_PATH=/v1/voice-turn
# DSH_VOICE_HEALTH_PATH=/health
# DSH_VOICE_SPEAK_PATH=     # optional; empty = auto /v1/speak → /v1/tts
# TTS_SOX_GAIN=1
# DSH_TTS_VOICE=zh-CN-XiaoxuanNeural
# --- Auto greet + idle proactive (PC bridge /v1/greet · /v1/proactive-tick) ---
# VOICE_GREET=1                      # board-dsh-chat / board-voice-once: greet once on start
# GREET_ON_START=1                   # alias; 0 to skip
# GREET_ON_PAIR=0                    # board-dsh-pair.sh: greet right after pair (needs SID)
# GREET_FORCE=0                      # 1 = ignore once-per-session skip on bridge
# CHAT_GREET_TEXT=                   # empty → bridge DSH_GREET_TEXT (大肥鱼 default)
# VOICE_IDLE_SECS=0                  # e.g. 180; also PROACTIVE_IDLE_S=…
# PROACTIVE_IDLE_S=0                 # synonym for VOICE_IDLE_SECS
# CHAT_IDLE_TEXT=                    # empty → bridge random DSH_PROACTIVE_LINES
# ./board-greet.sh                   # manual one-shot greet → aplay CON24
# ./board-proactive-tick.sh          # manual idle nudge (respects bridge cooldown)
# REC_SECS=5
# ./board-voice-once.sh              # greets then mic turn
# ./board-tts-pull.sh '主动播文本'   # no mic
# SPEAK_INJECT=1 ./board-tts-pull.sh '…'  # TTS + Desktop session.prompt



# --- Optional cloud ASR/TTS (separate speech provider; DeepSeek has no /v1/audio/*) ---
# ASR_API_KEY=
# TTS_API_KEY=
# ASR_BASE_URL=https://api.openai.com/v1
# TTS_BASE_URL=https://api.openai.com/v1
# VOICE_IN=0
# VOICE_OUT=1
# TTS_STUB=0

